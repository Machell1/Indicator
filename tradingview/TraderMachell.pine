//@version=6
// ============================================================================
// TraderMachell — Dale Volume-Profile Model (TradingView port)
// Mirrors indicator/dale_core.js + clean signal shell from indicator/wrapper.js
//
// CME session roll 17:00 New York · Asian + NY trade windows · pre-London blackout
// Prior-POC: touch → absorption → initiative → reaction SL → prior-POC TP
// ACCUM rotation retest with LVN stop + prior-POC target stack
// Clean default: BUY/SELL labels, SL/TP rays, risk/reward zone shading
//
// Delta: intrabar up/down split via request.security_lower_tf when available;
// otherwise range-position proxy (disclosed in research mode panel).
// ============================================================================

indicator("TraderMachell — Dale Volume-Profile Model", "TraderMachell", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─── inputs ───────────────────────────────────────────────────────────────
gM = "Mode"
cleanSignals = input.bool(true, "Clean signal chart (hide research UI)", group = gM)
showLevels     = input.bool(true, "Prior POC / VAH / VAL lines", group = gM)
tradeZones     = input.bool(true, "Risk / reward zone shading", group = gM)
zoneOpacity    = input.int(18, "Zone opacity %", minval = 1, maxval = 80, group = gM)
absorbZones    = input.bool(true, "Absorption bands at levels", group = gM)
absorbOpacity  = input.int(35, "Absorption opacity %", minval = 5, maxval = 80, group = gM)

gS = "Sessions (New York clock)"
sessionWindow = input.int(2, "Trade window", minval = 0, maxval = 2,
     tooltip = "0 = NY only, 1 = Asian only, 2 = both", group = gS)
asianStart = input.int(18, "Asian start hour", minval = 0, maxval = 23, group = gS)
asianEnd   = input.int(3, "Asian end hour", minval = 0, maxval = 23, group = gS)
nyStart    = input.int(9, "NY start hour", minval = 0, maxval = 23, group = gS)
nyEnd      = input.int(11, "NY end hour", minval = 0, maxval = 23, group = gS)
avoidPreLon  = input.bool(true, "Skip pre-London hour (manipulation)", group = gS)
preLonStart  = input.int(2, "Pre-London start", minval = 0, maxval = 23, group = gS)
preLonEnd    = input.int(3, "Pre-London end", minval = 0, maxval = 23, group = gS)

gP = "Profiles (research mode)"
rows       = input.int(80, "Profile rows", minval = 20, maxval = 160, group = gP)
vaIn       = input.float(70, "Value area %", minval = 50, maxval = 90, group = gP)
showPrev   = input.bool(true, "Prior session POC / VAH / VAL", group = gP)
showDev    = input.bool(false, "Developing session profile", group = gP)
showNPOC   = input.bool(false, "Naked POC rays", group = gP)
nakedMax   = input.int(6, "Naked POC count", minval = 1, maxval = 20, group = gP)
showFlex   = input.bool(false, "ACCUM rotation histogram", group = gP)
flexRows   = input.int(40, "Histogram rows", minval = 10, maxval = 80, group = gP)
flexW      = input.int(60, "Histogram width (bars)", minval = 10, maxval = 200, group = gP)

gSig = "Signals"
useAccum   = input.bool(true, "ACCUM rotation retest", group = gSig)
useStack   = input.bool(true, "Prior-POC stack", group = gSig)
moveAwayATR = input.float(1.0, "Re-arm distance (ATR)", step = 0.1, group = gSig)
flipBufATR  = input.float(0.15, "POC flip buffer (ATR)", step = 0.05, group = gSig)
nearATR     = input.float(0.30, "Touch proximity (ATR)", step = 0.05, group = gSig)
sigBars     = input.int(15, "Signature window (bars)", minval = 3, group = gSig)
initBars    = input.int(5, "Initiative window (bars)", minval = 1, group = gSig)
rotBars     = input.int(30, "Rotation min length", minval = 10, group = gSig)
rotMaxA     = input.float(1.5, "Rotation max height (ATR)", step = 0.1, group = gSig)
rotBrkA     = input.float(1.0, "Breakout extension (ATR)", step = 0.1, group = gSig)
priorDays   = input.int(10, "Prior POCs for targets", minval = 1, maxval = 30, group = gSig)
tpFrontATR  = input.float(0.15, "Target front-run (ATR)", step = 0.05, group = gSig)

gV = "Colors"
cPoc  = input.color(#F0B429, "Prior POC", group = gV)
cVa   = input.color(#7C93A8, "Prior VA", group = gV)
cDev  = input.color(#2DA88F, "Developing", group = gV)
cNak  = input.color(#9B7ED8, "Naked POC", group = gV)
cAcc  = input.color(#4FA3D1, "ACCUM", group = gV)
cBuy  = input.color(#26A17B, "BUY", group = gV)
cSell = input.color(#E05260, "SELL", group = gV)
cSl   = input.color(#7A6060, "Stop", group = gV)
cTp   = input.color(#26A17B, "Target", group = gV)
cBidAbs = input.color(#26A17B, "Bid absorption", group = gV)
cAskAbs = input.color(#E05260, "Offer absorption", group = gV)

vaPct = vaIn / 100.0
barMin = math.max(1, timeframe.in_seconds() / 60)
showTbl = not cleanSignals

// ─── delta (intrabar when available) ──────────────────────────────────────
lowTf = timeframe.period == "1" ? "1S" : "1"
[lV, lO, lC] = request.security_lower_tf(syminfo.tickerid, lowTf, [volume, open, close])

f_delta() =>
    float d = 0.0
    bool real = false
    if array.size(lV) > 0
        real := true
        for i = 0 to array.size(lV) - 1
            float v = array.get(lV, i)
            float o = array.get(lO, i)
            float c = array.get(lC, i)
            d += c > o ? v : c < o ? -v : 0.0
    else
        float rg = high - low
        d := rg > 0 ? volume * (2.0 * (close - low) / rg - 1.0) : 0.0
    [d, real]

[dlt, deltaReal] = f_delta()

// ─── NY session / window helpers ───────────────────────────────────────────
f_sessionKey() =>
    int h = hour(time, "America/New_York")
    int tAdj = time
    if h >= 17
        tAdj := timestamp("America/New_York", year(time, "America/New_York"),
             month(time, "America/New_York"), dayofmonth(time, "America/New_York") + 1, 0, 0)
    int y = year(tAdj, "America/New_York")
    int mo = month(tAdj, "America/New_York")
    int d = dayofmonth(tAdj, "America/New_York")
    y * 10000 + mo * 100 + d

f_inHourWindow(start, end) =>
    int h = hour(time, "America/New_York")
    start < end ? (h >= start and h < end) : (h >= start or h < end)

f_inNyWindow() =>
    f_inHourWindow(nyStart, nyEnd)

f_inAsianWindow() =>
    f_inHourWindow(asianStart, asianEnd)

f_inPreLonBlackout() =>
    avoidPreLon and f_inHourWindow(preLonStart, preLonEnd)

f_inTradeWindow() =>
    bool inWin = sessionWindow == 0 ? f_inNyWindow() :
         sessionWindow == 2 ? (f_inNyWindow() or f_inAsianWindow()) :
         f_inAsianWindow()
    inWin and not f_inPreLonBlackout()

// ─── profile engine ────────────────────────────────────────────────────────
f_profile(hs, ls, vs, nrows) =>
    float poc = na
    float vah = na
    float val = na
    float gridLo = na
    float step = na
    array<float> bins = array.new_float(0)
    int n = array.size(ls)
    if n > 5
        float lo = array.min(ls)
        float hi = array.max(hs)
        step := math.max((hi - lo) / nrows, syminfo.mintick)
        gridLo := lo - 40 * step
        int nb = nrows + 90
        bins := array.new_float(nb, 0.0)
        float tot = 0.0
        for i = 0 to n - 1
            int a = math.max(int((array.get(ls, i) - gridLo) / step), 0)
            int z = math.min(math.max(int((array.get(hs, i) - gridLo) / step), a), nb - 1)
            float sh = array.get(vs, i) / (z - a + 1)
            for k = a to z
                array.set(bins, k, array.get(bins, k) + sh)
            tot += array.get(vs, i)
        if tot > 0
            int pr = array.indexof(bins, array.max(bins))
            poc := gridLo + (pr + 0.5) * step
            float need = tot * vaPct
            float acc = array.get(bins, pr)
            int up = pr
            int dn = pr
            while acc < need
                float a2 = up + 1 < nb ? array.get(bins, up + 1) : 0.0
                float b2 = dn - 1 >= 0 ? array.get(bins, dn - 1) : 0.0
                if a2 <= 0 and b2 <= 0
                    break
                if a2 >= b2
                    up += 1
                    acc += a2
                else
                    dn -= 1
                    acc += b2
            vah := gridLo + (up + 1) * step
            val := gridLo + dn * step
    [poc, vah, val, gridLo, step, bins]

f_median(a) =>
    int n = array.size(a)
    float r = na
    if n > 0
        array<float> c = array.copy(a)
        array.sort(c, order.ascending)
        int m = n >> 1
        r := n % 2 == 1 ? array.get(c, m) : (array.get(c, m - 1) + array.get(c, m)) / 2.0
    r

f_pctile(a, p) =>
    float r = na
    int n = array.size(a)
    if n > 4
        array<float> c = array.copy(a)
        array.sort(c, order.ascending)
        r := array.get(c, math.min(n - 1, int(n * p / 100.0)))
    r

f_stopBehindLVN(val, vah, gridLo, step, bins, forLong, atr) =>
    float sl = na
    float pv = array.max(bins)
    int nb = array.size(bins)
    if forLong
        int k0 = math.max(0, int((val - gridLo) / step))
        for i = 0 to 60
            int k = k0 - 1 - i
            if k < 0
                break
            if array.get(bins, k) < 0.30 * pv
                sl := gridLo + k * step - 0.10 * atr
                break
        if na(sl)
            sl := val - 0.60 * atr
    else
        int k0 = math.min(nb - 1, int((vah - gridLo) / step))
        for i = 0 to 60
            int k = k0 + i
            if k >= nb
                break
            if array.get(bins, k) < 0.30 * pv
                sl := gridLo + (k + 1) * step + 0.10 * atr
                break
        if na(sl)
            sl := vah + 0.60 * atr
    sl

f_target(entry, dirn, atr, rr, pocArr) =>
    float tp = na
    float best = na
    int n = array.size(pocArr)
    int start = math.max(0, n - priorDays)
    for i = start to n - 1
        float p = array.get(pocArr, i)
        if (p - entry) * dirn > 0.05 * atr
            if na(best) or math.abs(p - entry) < math.abs(best - entry)
                best := p
    if not na(best)
        tp := best - dirn * tpFrontATR * atr
    else
        tp := entry + dirn * 0.8 * atr
    if rr > 0 and math.abs(tp - entry) < 0.5 * rr
        tp := entry + dirn * rr
    tp

// ─── rolling buffers ───────────────────────────────────────────────────────
int sk = f_sessionKey()
bool newSess = ta.change(sk) != 0

var array<float> sH = array.new_float()
var array<float> sL = array.new_float()
var array<float> sV = array.new_float()
var array<float> sR = array.new_float()
var array<float> sD = array.new_float()
var array<float> rH = array.new_float()
var array<float> rL = array.new_float()
var array<float> rC = array.new_float()
var array<float> rV = array.new_float()
var array<float> rD = array.new_float()
var array<float> rR = array.new_float()
var array<float> priorPocs = array.new_float()
var array<float> nakeds = array.new_float()

var float pPoc = na
var float pVah = na
var float pVal = na
var bool prevLiquid = false
var float dPoc = na
var float dVah = na
var float dVal = na
var int sCount = 0
var float atrV = na

const int LIQ_MIN_VOL = 2000
const int LIQ_MIN_BARS = 120
const int SIG_WIN = 120
const int ATR_WIN = 420
const int RECENT_MAX = 3100

if newSess and array.size(sL) > 5
    [p1, a1, v1, g1, s1, b1] = f_profile(sH, sL, sV, rows)
    if not na(p1)
        if not na(pPoc)
            array.push(nakeds, pPoc)
            while array.size(nakeds) > nakedMax
                array.shift(nakeds)
        pPoc := p1
        pVah := a1
        pVal := v1
        array.push(priorPocs, p1)
        while array.size(priorPocs) > 50
            array.shift(priorPocs)
        float sessVol = 0.0
        for i = 0 to array.size(sV) - 1
            sessVol += array.get(sV, i)
        prevLiquid := sessVol >= LIQ_MIN_VOL and array.size(sV) >= math.round(LIQ_MIN_BARS / barMin)
    array.clear(sH)
    array.clear(sL)
    array.clear(sV)
    array.clear(sR)
    array.clear(sD)
    sCount := 0

array.push(sH, high)
array.push(sL, low)
array.push(sV, volume)
array.push(sR, high - low)
array.push(sD, dlt)
sCount += 1

array.push(rH, high)
array.push(rL, low)
array.push(rC, close)
array.push(rV, volume)
array.push(rD, dlt)
array.push(rR, high - low)
while array.size(rH) > RECENT_MAX
    array.shift(rH)
    array.shift(rL)
    array.shift(rC)
    array.shift(rV)
    array.shift(rD)
    array.shift(rR)

if showNPOC and array.size(nakeds) > 0
    for i = array.size(nakeds) - 1 to 0
        if i < array.size(nakeds)
            float lv = array.get(nakeds, i)
            if low <= lv and high >= lv
                array.remove(nakeds, i)

if showDev and sCount > 30 and bar_index % 10 == 0
    [p2, a2, v2, g2, s2, b2] = f_profile(sH, sL, sV, rows)
    dPoc := p2
    dVah := a2
    dVal := v2

// ATR: mean 1-min range × (30 / barMin)
if array.size(rR) > 0
    int aw = math.min(ATR_WIN, array.size(rR))
    float rs = 0.0
    for i = 0 to aw - 1
        rs += array.get(rR, array.size(rR) - 1 - i)
    atrV := (rs / aw) * (30.0 / barMin)

// ─── prior-POC state machine ───────────────────────────────────────────────
var bool P_side = false
var bool P_sideInit = false
var bool P_wasOut = false
var bool P_armed = false
var float P_maxd = 0.0
var bool P_flipped = false
var int P_touchedAt = -1
var float P_reactExt = na
var int P_absorbAt = -1
var bool P_done = false
var bool P_fired = false

// ─── ACCUM state ───────────────────────────────────────────────────────────
var float accLvl = na
var float accVah = na
var float accVal = na
var float accGrid = na
var float accStep = na
var array<float> accBins = array.new_float(0)
var bool accShort = false
var bool accDone = false
var bool accWasOut = false
var float accMaxD = 0.0
var int accBar = na
var array<float> fH = array.new_float()
var array<float> fL = array.new_float()
var array<float> fV = array.new_float()

// ─── absorption zone ledger ──────────────────────────────────────────────────
var array<float> azPrice = array.new_float()
var array<float> azBid = array.new_float()
var array<float> azOffer = array.new_float()

if newSess
    P_sideInit := false
    P_wasOut := false
    P_armed := false
    P_maxd := 0.0
    P_flipped := false
    P_touchedAt := -1
    P_reactExt := na
    P_absorbAt := -1
    P_done := false
    P_fired := false
    accLvl := na
    accVah := na
    accVal := na
    accGrid := na
    accStep := na
    accBins := array.new_float(0)
    accShort := false
    accDone := false
    accWasOut := false
    accMaxD := 0.0
    accBar := na
    array.clear(fH)
    array.clear(fL)
    array.clear(fV)
    array.clear(azPrice)
    array.clear(azBid)
    array.clear(azOffer)

// ─── ACCUM rotation detect (mirror _detectAccum) ─────────────────────────────
if not na(atrV) and atrV > 0 and bar_index > rotBars + 5 and barstate.isconfirmed
    int rn = array.size(rH)
    int L = rotBars
    if rn >= L + 10
        float thresh = rotMaxA * atrV
        float brk = rotBrkA * atrV
        int e = rn - 1 - L
        bool found = false
        while e >= L and not found
            float wHi = -1e9
            float wLo = 1e9
            for i = e - L + 1 to e
                float h = array.get(rH, i)
                float l = array.get(rL, i)
                if h > wHi
                    wHi := h
                if l < wLo
                    wLo := l
            int s = e - L + 1
            if wHi - wLo <= thresh
                while s > 0
                    float nh = math.max(wHi, array.get(rH, s - 1))
                    float nl = math.min(wLo, array.get(rL, s - 1))
                    if nh - nl > thresh
                        break
                    wHi := nh
                    wLo := nl
                    s -= 1
                bool up = false
                bool dn = false
                float ext = 0.0
                int comp = -1
                bool dead = false
                for j = e + 1 to rn - 1
                    float cl = array.get(rC, j)
                    if not up and not dn
                        if cl > wHi + 0.2 * atrV
                            up := true
                        else if cl < wLo - 0.2 * atrV
                            dn := true
                        continue
                    if up
                        float hh = array.get(rH, j) - wHi
                        if hh > ext
                            ext := hh
                        if cl < wLo - 0.2 * atrV
                            dead := true
                            break
                    else
                        float ll = wLo - array.get(rL, j)
                        if ll > ext
                            ext := ll
                        if cl > wHi + 0.2 * atrV
                            dead := true
                            break
                    if ext >= brk and comp < 0
                        comp := j
                if comp > 0 and not dead
                    array.clear(fH)
                    array.clear(fL)
                    array.clear(fV)
                    for j = s to e
                        array.push(fH, array.get(rH, j))
                        array.push(fL, array.get(rL, j))
                        array.push(fV, array.get(rV, j))
                    [fp, fa, fv, fg, fs, fb] = f_profile(fH, fL, fV, flexRows)
                    if not na(fp)
                        accLvl := fp
                        accVah := fa
                        accVal := fv
                        accGrid := fg
                        accStep := fs
                        accBins := fb
                        accShort := dn
                        accBar := bar_index
                        accDone := false
                        accWasOut := false
                        accMaxD := 0.0
                        found := true
            e := s - 5

// Track absorption at levels
if not na(atrV) and atrV > 0 and array.size(sV) >= 5
    int sw = math.min(SIG_WIN, array.size(sV))
    array<float> wV = array.new_float()
    array<float> wR = array.new_float()
    for i = 0 to sw - 1
        array.push(wV, array.get(sV, array.size(sV) - 1 - i))
        array.push(wR, array.get(sR, array.size(sR) - 1 - i))
    float vmed = f_median(wV)
    float rmed = f_median(wR)
    if vmed > 0 and rmed > 0
        float bidVol = math.max(0, (volume - dlt) / 2.0)
        float offerVol = math.max(0, (volume + dlt) / 2.0)
        float zone = 0.30 * atrV
        bool churn = volume >= 1.2 * vmed and (high - low) <= 1.0 * rmed
        array<float> lvlPx = array.new_float()
        array<string> lvlTag = array.new_string()
        if not na(pPoc)
            array.push(lvlPx, pPoc)
            array.push(lvlTag, "POC")
        if not na(accLvl)
            array.push(lvlPx, accLvl)
            array.push(lvlTag, "ACCUM")
        for li = 0 to array.size(lvlPx) - 1
            float lp = array.get(lvlPx, li)
            if low > lp + zone or high < lp - zone
                continue
            bool holds = lp >= low - zone and lp <= high + zone
            if not holds
                continue
            bool bidAbs = churn and bidVol >= offerVol * 1.05 and low >= lp - zone
            bool offerAbs = churn and offerVol >= bidVol * 1.05 and high <= lp + zone
            if not bidAbs and not offerAbs
                continue
            float stepK = math.max(atrV * 0.05, syminfo.mintick)
            int key = int(math.round(lp / stepK))
            int zi = -1
            for z = 0 to array.size(azPrice) - 1
                if int(math.round(array.get(azPrice, z) / stepK)) == key
                    zi := z
                    break
            if zi < 0
                array.push(azPrice, lp)
                array.push(azBid, bidAbs ? bidVol : 0.0)
                array.push(azOffer, offerAbs ? offerVol : 0.0)
            else
                if bidAbs
                    array.set(azBid, zi, array.get(azBid, zi) + bidVol)
                if offerAbs
                    array.set(azOffer, zi, array.get(azOffer, zi) + offerVol)

// ─── signal outputs ──────────────────────────────────────────────────────────
bool sigBuy = false
bool sigSell = false
var float ePx = na
var float eSl = na
var float eTp = na
var int eBar = na
var bool eLong = false
var string eKind = ""
var string status = "waiting for a session profile"

int iBar = array.size(sV) - 1
bool inWin = f_inTradeWindow()
float px = close

if not na(atrV) and atrV > 0 and barstate.isconfirmed
    // --- prior-POC machine ---
    if useStack and not na(pPoc) and prevLiquid and not P_done and array.size(sV) >= 5
        float lvl = pPoc
        bool above = px > lvl
        if P_touchedAt < 0
            if not P_sideInit
                P_side := above
                P_sideInit := true
            else if P_side != above
                float beyond = P_side ? lvl - px : px - lvl
                if not P_flipped and beyond >= flipBufATR * atrV
                    P_flipped := true
                    P_side := above
                    P_armed := false
                    P_wasOut := false
                    P_maxd := 0.0
            float d = math.abs(px - lvl)
            if d > P_maxd
                P_maxd := d
            if d > 0.10 * atrV
                P_wasOut := true
            if not P_armed and P_maxd >= moveAwayATR * atrV
                P_armed := true
            if P_armed and P_wasOut and inWin
                bool touch = low <= lvl and high >= lvl
                if touch and bar_index > 0
                    bool sideLong = close[1] > lvl
                    P_side := sideLong
                    P_touchedAt := iBar
                    P_reactExt := sideLong ? low : high
        else
            P_reactExt := P_side ? math.min(P_reactExt, low) : math.max(P_reactExt, high)
            int since = iBar - P_touchedAt
            if since > sigBars
                P_done := true
            else
                int sw = math.min(SIG_WIN, array.size(sV))
                array<float> vols = array.new_float()
                array<float> rngs = array.new_float()
                array<float> dmags = array.new_float()
                for wi = 0 to sw - 1
                    int idx = array.size(sV) - 1 - wi
                    array.push(vols, array.get(sV, idx))
                    array.push(rngs, array.get(sR, idx))
                    array.push(dmags, math.abs(array.get(sD, idx)))
                float vmed = f_median(vols)
                float rmed = f_median(rngs)
                float d75 = f_pctile(dmags, 75)
                bool longSide = P_side
                if P_absorbAt < 0
                    bool holds = longSide ? low > lvl - nearATR * atrV : high < lvl + nearATR * atrV
                    if volume >= 1.3 * vmed and (high - low) <= 0.9 * rmed and holds
                        P_absorbAt := iBar
                else if iBar - P_absorbAt > initBars
                    P_absorbAt := -1
                else
                    bool init = math.abs(dlt) >= d75 and (longSide ? dlt > 0 : dlt < 0)
                    if init
                        P_done := true
                        float entry = px
                        float sl = longSide ? P_reactExt - 0.10 * atrV : P_reactExt + 0.10 * atrV
                        bool ok = longSide ? sl < entry : sl > entry
                        if ok
                            float dirn = longSide ? 1.0 : -1.0
                            float rr = math.abs(entry - sl)
                            float tp = f_target(lvl, dirn, atrV, rr, priorPocs)
                            P_fired := true
                            eLong := longSide
                            ePx := entry
                            eSl := sl
                            eTp := tp
                            eBar := bar_index
                            eKind := "STACK"
                            sigBuy := longSide
                            sigSell := not longSide
                            status := (longSide ? "BUY" : "SELL") + " prior-POC stack"

    // --- ACCUM retest ---
    if useAccum and not na(accLvl) and not accDone
        float dAbs = math.abs(px - accLvl)
        if dAbs > accMaxD
            accMaxD := dAbs
        if dAbs > 0.10 * atrV
            accWasOut := true
        if accMaxD >= moveAwayATR * atrV and accWasOut and inWin
            bool touch = accShort ? high >= accLvl : low <= accLvl
            if touch
                accDone := true
                if math.abs(px - accLvl) <= nearATR * atrV
                    bool longAcc = not accShort
                    float sl = f_stopBehindLVN(accVal, accVah, accGrid, accStep, accBins, longAcc, atrV)
                    float entry = accLvl
                    if (longAcc ? sl < entry : sl > entry) and (longAcc ? px > sl : px < sl)
                        float dirn = longAcc ? 1.0 : -1.0
                        float rr = math.abs(entry - sl)
                        float tp = f_target(entry, dirn, atrV, rr, priorPocs)
                        eLong := longAcc
                        ePx := entry
                        eSl := sl
                        eTp := tp
                        eBar := bar_index
                        eKind := "ACCUM"
                        sigBuy := longAcc
                        sigSell := not longAcc
                        status := (longAcc ? "BUY" : "SELL") + " ACCUM retest"

// Status line
if na(pPoc)
    status := "waiting: no prior-session profile yet"
else if not prevLiquid
    status := "stand down: prior session too thin"
else if P_done and P_fired
    status := "signal complete for the session"
else if P_done and P_touchedAt >= 0
    status := "stood down: no absorption-initiative signature"
else if P_touchedAt >= 0
    status := "TOUCHED — waiting for absorption-initiative"
else if P_armed and inWin
    status := P_side ? "armed: buy the retest from above" : "armed: sell the retest from below"
else if P_armed and f_inPreLonBlackout()
    status := "stand down: pre-London hour"
else if P_armed
    status := "armed — outside trade window"

// ─── level plots ───────────────────────────────────────────────────────────
bool showLvl = showLevels or not cleanSignals
plot(showLvl and showPrev ? pPoc : na, "PREV POC", cPoc, 2, plot.style_linebr)
plot(showLvl and showPrev ? pVah : na, "PREV VAH", cVa, 1, plot.style_linebr)
plot(showLvl and showPrev ? pVal : na, "PREV VAL", cVa, 1, plot.style_linebr)
plot((not cleanSignals and showDev) ? dPoc : na, "dPOC", cDev, 1, plot.style_linebr)
plot((not cleanSignals and showDev) ? dVah : na, "dVAH", color.new(cDev, 50), 1, plot.style_linebr)
plot((not cleanSignals and showDev) ? dVal : na, "dVAL", color.new(cDev, 50), 1, plot.style_linebr)
plot((not cleanSignals and useAccum) ? accLvl : na, "ACCUM", cAcc, 2, plot.style_linebr)

// ─── signal graphics ─────────────────────────────────────────────────────────
var array<line> sigLines = array.new<line>()
var array<box> sigBoxes = array.new<box>()
var array<label> sigLabels = array.new<label>()

if sigBuy or sigSell
    color sigCol = sigBuy ? cBuy : cSell
    string sigSide = sigBuy ? "BUY" : "SELL"
    int x0 = bar_index
    int x1 = bar_index + 12
    array.push(sigLines, line.new(x0, ePx, x1, ePx, color = color.new(#78909C, 30), width = 1))
    array.push(sigLines, line.new(x0, eSl, x1, eSl, color = cSl, width = 2, style = line.style_dashed))
    array.push(sigLines, line.new(x0, eTp, x1, eTp, color = cTp, width = 2, style = line.style_dotted))
    if tradeZones
        array.push(sigBoxes, box.new(x0, math.max(ePx, eSl), x1, math.min(ePx, eSl),
             border_width = 0, bgcolor = color.new(cSl, 100 - zoneOpacity)))
        array.push(sigBoxes, box.new(x0, math.max(ePx, eTp), x1, math.min(ePx, eTp),
             border_width = 0, bgcolor = color.new(cTp, 100 - zoneOpacity)))
    array.push(sigLabels, label.new(x0, ePx, sigBuy ? "\u25B2" : "\u25BC",
         style = label.style_none, color = na, textcolor = sigCol, size = size.large))
    array.push(sigLabels, label.new(x0, ePx, sigSide + "  " + eKind,
         style = sigBuy ? label.style_label_up : label.style_label_down,
         color = color.new(sigCol, 15), textcolor = #FFFFFF, size = size.normal))
    array.push(sigLabels, label.new(x1, eSl, "SL  " + str.tostring(eSl, format.mintick),
         style = label.style_label_left, color = color.new(cSl, 20), textcolor = cSl, size = size.tiny))
    array.push(sigLabels, label.new(x1, eTp, "TP  " + str.tostring(eTp, format.mintick),
         style = label.style_label_left, color = color.new(cTp, 20), textcolor = cTp, size = size.tiny))
    array.push(sigLabels, label.new(x1, ePx, sigSide + "  " + str.tostring(ePx, format.mintick),
         style = label.style_label_left, color = color.new(sigCol, 20), textcolor = sigCol, size = size.tiny))
    while array.size(sigLines) > 400
        line.delete(array.shift(sigLines))
    while array.size(sigBoxes) > 200
        box.delete(array.shift(sigBoxes))
    while array.size(sigLabels) > 200
        label.delete(array.shift(sigLabels))

// Extend open signal rays on last bar
if barstate.islast and not na(eBar)
    int x1 = bar_index + 12
    // extend most recent lines if present
    int nl = array.size(sigLines)
    if nl >= 3
        line.set_x2(array.get(sigLines, nl - 3), x1)
        line.set_x2(array.get(sigLines, nl - 2), x1)
        line.set_x2(array.get(sigLines, nl - 1), x1)
    int nb = array.size(sigBoxes)
    if nb >= 2 and tradeZones
        box.set_right(array.get(sigBoxes, nb - 2), x1)
        box.set_right(array.get(sigBoxes, nb - 1), x1)

// ─── absorption zone bands ───────────────────────────────────────────────────
var array<box> absBoxes = array.new<box>()
if absorbZones and barstate.islast
    while array.size(absBoxes) > 0
        box.delete(array.pop(absBoxes))
    if not na(atrV) and atrV > 0 and array.size(azPrice) > 0
        int sw = math.min(SIG_WIN, array.size(sV))
        array<float> wV = array.new_float()
        for wi = 0 to sw - 1
            array.push(wV, array.get(sV, array.size(sV) - 1 - wi))
        float vmed = f_median(wV)
        float minVol = vmed > 0 ? vmed * 0.5 : 0.0
        float half = math.max(atrV * 0.04, syminfo.mintick)
        int x0 = math.max(0, bar_index - 120)
        int x1 = bar_index + 8
        for zi = 0 to array.size(azPrice) - 1
            float bv = array.get(azBid, zi)
            float ov = array.get(azOffer, zi)
            if bv + ov < minVol
                continue
            float lp = array.get(azPrice, zi)
            if bv > ov
                array.push(absBoxes, box.new(x0, lp + half, x1, lp - half,
                     border_width = 0, bgcolor = color.new(cBidAbs, 100 - absorbOpacity)))
            else if ov > bv
                array.push(absBoxes, box.new(x0, lp + half, x1, lp - half,
                     border_width = 0, bgcolor = color.new(cAskAbs, 100 - absorbOpacity)))

// ─── research UI: naked POC + flex histogram + tags ───────────────────────────
var array<line> nkL = array.new<line>()
var array<label> nkT = array.new<label>()
var array<box> fBox = array.new<box>()

if not cleanSignals and barstate.islast
    while array.size(nkL) > 0
        line.delete(array.pop(nkL))
    while array.size(nkT) > 0
        label.delete(array.pop(nkT))
    while array.size(fBox) > 0
        box.delete(array.pop(fBox))
    if showNPOC and array.size(nakeds) > 0
        for i = 0 to array.size(nakeds) - 1
            float lv = array.get(nakeds, i)
            array.push(nkL, line.new(bar_index - 300, lv, bar_index + 15, lv,
                 color = color.new(cNak, 35), style = line.style_dotted))
            array.push(nkT, label.new(bar_index + 15, lv, "NPOC " + str.tostring(lv, format.mintick),
                 style = label.style_label_left, color = color.new(#12161C, 20), textcolor = cNak, size = size.tiny))
    if showFlex and array.size(accBins) > 0 and not na(accGrid) and not na(accStep) and not na(accBar)
        float mx = array.max(accBins)
        if mx > 0
            for k = 0 to array.size(accBins) - 1
                float vv = array.get(accBins, k)
                if vv > 0
                    int w = int(flexW * vv / mx)
                    if w > 0
                        float y0 = accGrid + k * accStep
                        int xb = math.max(accBar, bar_index - 300)
                        array.push(fBox, box.new(xb, y0 + accStep, xb + w, y0,
                             border_width = 0, bgcolor = color.new(cAcc, vv >= mx * 0.98 ? 30 : 72)))

// ─── status panel (research mode) ────────────────────────────────────────────
var table t = table.new(position.top_left, 2, 6, bgcolor = color.new(#0E1218, 8),
     frame_color = color.new(#394452, 30), frame_width = 1)

f_kv(r, k, v, c) =>
    table.cell(t, 0, r, k, text_size = size.small, text_color = #7C8B9C, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_size = size.small, text_color = c, text_halign = text.align_left)

if showTbl and barstate.islast
    f_kv(0, "TraderMachell", status, #E6EDF3)
    f_kv(1, "PREV POC/VAH/VAL",
         (na(pPoc) ? "—" : str.tostring(pPoc, format.mintick)) + "  " +
         (na(pVah) ? "—" : str.tostring(pVah, format.mintick)) + "  " +
         (na(pVal) ? "—" : str.tostring(pVal, format.mintick)), cPoc)
    f_kv(2, "Session window",
         sessionWindow == 0 ? "NY " + str.tostring(nyStart) + "-" + str.tostring(nyEnd) :
         sessionWindow == 2 ? "Asian+" + str.tostring(nyStart) + "-" + str.tostring(nyEnd) :
         "Asian " + str.tostring(asianStart) + "-" + str.tostring(asianEnd), #7C8B9C)
    f_kv(3, "ACCUM / naked", (na(accLvl) ? "—" : str.tostring(accLvl, format.mintick)) +
         "   n=" + str.tostring(array.size(nakeds)), cAcc)
    f_kv(4, "ATR / last R", (na(atrV) ? "—" : str.tostring(atrV, format.mintick)) +
         (na(eSl) or na(ePx) ? "" : "   R=" + str.tostring(math.abs(ePx - eSl), format.mintick)), #7C8B9C)
    f_kv(5, "Delta source", deltaReal ? "intrabar " + lowTf : "range proxy (ungraded)",
         deltaReal ? #26A17B : #E0A33A)

alertcondition(sigBuy, "TraderMachell BUY", "TraderMachell BUY signal")
alertcondition(sigSell, "TraderMachell SELL", "TraderMachell SELL signal")
